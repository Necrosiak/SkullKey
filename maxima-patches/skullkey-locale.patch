--- a/maxima-lib/src/core/settings.rs
+++ b/maxima-lib/src/core/settings.rs
@@ -7,4 +7,14 @@ pub enum MaximaSetting {
     IsIgoEnabled,
     IsIgoAvailable,
     Environment,
+    Language,
+}
+
+/// Language games run in, as the EA app reports it over LSX (the language
+/// picked at install). Set MAXIMA_LOCALE (e.g. fr_FR) to override en_US.
+pub fn game_locale() -> String {
+    std::env::var("MAXIMA_LOCALE")
+        .ok()
+        .filter(|l| l.len() == 5 && l.as_bytes()[2] == b'_')
+        .unwrap_or_else(|| "en_US".to_string())
 }
