+//! Installer arguments: preserve Windows quoting and keep key values out of Debug.
+use super::ManifestError;
+use crate::core::legacy_keys::LegacyCdKey;
+use crate::util::native::platform_path;
+use std::{
+    fmt,
+    path::{Path, PathBuf},
+};
+
+pub(crate) fn requires_key(parameters: &str) -> bool {
+    let lower = parameters.to_ascii_lowercase();
+    lower.contains("{cdkey}") || lower.contains("%cdkey%")
+}
+
+pub(crate) struct PreparedInstallerArgs {
+    pub(crate) values: Vec<PathBuf>,
+    pub(crate) sensitive: bool,
+}
+impl fmt::Debug for PreparedInstallerArgs {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("PreparedInstallerArgs")
+            .field("count", &self.values.len())
+            .field("sensitive", &self.sensitive)
+            .finish()
+    }
+}
+
+// Windows CRT quote/backslash rules for balanced input, not POSIX parsing.
+// Deliberately reject malformed input before substituting a private value.
+// https://learn.microsoft.com/en-us/cpp/c-language/parsing-c-command-line-arguments
+fn split_windows(parameters: &str) -> Result<Vec<String>, ManifestError> {
+    let mut out = Vec::new();
+    let mut word = String::new();
+    let mut quoted = false;
+    let mut started = false;
+    let mut chars = parameters.chars().peekable();
+    while let Some(c) = chars.next() {
+        match c {
+            ' ' | '\t' if !quoted => {
+                if started {
+                    out.push(std::mem::take(&mut word));
+                    started = false;
+                }
+            }
+            '\\' => {
+                started = true;
+                let mut count = 1;
+                while chars.peek() == Some(&'\\') {
+                    chars.next();
+                    count += 1;
+                }
+                if chars.peek() == Some(&'"') {
+                    chars.next();
+                    word.extend(std::iter::repeat('\\').take(count / 2));
+                    if count % 2 == 1 {
+                        word.push('"');
+                    } else if quoted && chars.peek() == Some(&'"') {
+                        chars.next();
+                        word.push('"');
+                    } else {
+                        quoted = !quoted;
+                    }
+                } else {
+                    word.extend(std::iter::repeat('\\').take(count));
+                }
+            }
+            '"' => {
+                started = true;
+                if quoted && chars.peek() == Some(&'"') {
+                    chars.next();
+                    word.push('"');
+                } else {
+                    quoted = !quoted;
+                }
+            }
+            '\r' | '\n' | '\0' => return Err(ManifestError::InvalidInstallerParameters),
+            _ => {
+                started = true;
+                word.push(c);
+            }
+        }
+    }
+    if quoted {
+        return Err(ManifestError::InvalidInstallerParameters);
+    }
+    if started {
+        out.push(word);
+    }
+    Ok(out)
+}
+
+pub(crate) fn prepare(
+    parameters: &str,
+    install_path: &Path,
+    key: Option<&LegacyCdKey>,
+) -> Result<PreparedInstallerArgs, ManifestError> {
+    let sensitive = requires_key(parameters);
+    if sensitive && key.is_none() {
+        return Err(ManifestError::MissingLegacyKey);
+    }
+    let windows = platform_path(
+        install_path
+            .to_str()
+            .ok_or(ManifestError::Decode)?
+            .trim_end_matches(['/', '\\'])
+            .replace('/', "\\"),
+    );
+    let location = windows.to_str().ok_or(ManifestError::Decode)?;
+    let token = regex::Regex::new(r"(?i)\{cdkey\}|%cdkey%").expect("fixed installer key pattern");
+    let mut values = Vec::new();
+    for argument in split_windows(parameters)? {
+        let argument = argument
+            .replace("{locale}", "en_US")
+            .replace("{installLocation}", location);
+        let argument = if sensitive {
+            token
+                .replace_all(
+                    &argument,
+                    regex::NoExpand(key.expect("key checked").as_secret_str()),
+                )
+                .into_owned()
+        } else {
+            argument
+        };
+        values.push(PathBuf::from(argument));
+    }
+    Ok(PreparedInstallerArgs { values, sensitive })
+}
+
+#[cfg(test)]
+mod installer_key_regression {
+    use super::*;
+    #[test]
+    fn quoted_install_location_is_one_argument() {
+        let a = prepare(
+            r#"install -locale {locale} -installPath "{installLocation}""#,
+            Path::new("/tmp/A Game"),
+            None,
+        )
+        .unwrap();
+        assert_eq!(a.values.len(), 5);
+        assert!(a.values[4].to_string_lossy().ends_with("tmp\\A Game"));
+        assert!(!a.sensitive);
+    }
+    #[test]
+    fn key_is_replaced_inside_one_argument_and_debug_is_redacted() {
+        let key = LegacyCdKey::fixture();
+        let a = prepare(
+            r#"install "CDKEY={CDKEY}""#,
+            Path::new("/tmp/Game"),
+            Some(&key),
+        )
+        .unwrap();
+        assert_eq!(a.values[1], PathBuf::from("CDKEY=FIXTURE-KEY"));
+        assert!(a.sensitive);
+        assert!(!format!("{:?}", a).contains("FIXTURE-KEY"));
+        let a = prepare("%CDKEY%", Path::new("/tmp/Game"), Some(&key)).unwrap();
+        assert_eq!(a.values[0], PathBuf::from("FIXTURE-KEY"));
+    }
+    #[test]
+    fn absent_key_blocks_required_installer() {
+        assert!(matches!(
+            prepare("{cdkey}", Path::new("/tmp/Game"), None),
+            Err(ManifestError::MissingLegacyKey)
+        ));
+    }
+    #[test]
+    fn malformed_quoting_and_control_characters_are_rejected() {
+        for input in ["install \"unterminated", "install\nmore", "install\0more"] {
+            assert!(matches!(
+                prepare(input, Path::new("/tmp/Game"), None),
+                Err(ManifestError::InvalidInstallerParameters)
+            ));
+        }
+    }
+    #[test]
+    fn quoted_windows_examples_preserve_backslashes_and_embedded_quotes() {
+        assert_eq!(
+            split_windows(r#""a b c" d e"#).unwrap(),
+            vec!["a b c", "d", "e"]
+        );
+        assert_eq!(
+            split_windows(r#"a\\\b d"e f"g h"#).unwrap(),
+            vec![r"a\\\b", "de fg", "h"]
+        );
+    }
+    #[test]
+    fn windows_backslashes_and_empty_arguments_are_preserved() {
+        assert_eq!(
+            split_windows(r#""" C:\Games\Test "A B""#).unwrap(),
+            vec!["", "C:\\Games\\Test", "A B"]
+        );
+    }
+}
