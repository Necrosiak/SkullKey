+async fn wait_private_command(command: &mut Command) -> Result<ExitStatus, std::io::Error> {
+    let mut process = command
+        .kill_on_drop(true)
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()?;
+    let mut stdout = process.stdout.take().expect("piped stdout");
+    let mut stderr = process.stderr.take().expect("piped stderr");
+    let mut sink_out = tokio::io::sink();
+    let mut sink_err = tokio::io::sink();
+    let (status, _, _) = tokio::try_join!(
+        process.wait(),
+        tokio::io::copy(&mut stdout, &mut sink_out),
+        tokio::io::copy(&mut stderr, &mut sink_err)
+    )?;
+    Ok(status)
+}
