+/// Resolve only when the installer declares a key input. Unknown registry paths
+/// and unrelated games are never guessed. No resolved value is logged or saved.
+pub async fn install_with_legacy_key<R, F, C>(
+    manifest: &dyn GameManifest,
+    path: &PathBuf,
+    resolver: R,
+    cancelled: C,
+) -> Result<(), ManifestError>
+where
+    R: FnOnce() -> F,
+    F: std::future::Future<Output = Result<Option<LegacyCdKey>, LegacyKeyError>>,
+    C: Fn() -> bool,
+{
+    if cancelled() {
+        return Err(ManifestError::Cancelled);
+    }
+    let key = if manifest.requires_legacy_key() {
+        Some(resolver().await?.ok_or(ManifestError::MissingLegacyKey)?)
+    } else {
+        None
+    };
+    if cancelled() {
+        return Err(ManifestError::Cancelled);
+    }
+    manifest.run_touchup(path, key.as_ref()).await
+}
