+
+#[derive(Default)]
+struct DownloadOutcome {
+    // 0: running, 1: success, 2: download failure, 3: installer failure, 4: cancelled.
+    state: AtomicU8,
+    notify: Arc<Notify>,
+}
+
+impl DownloadOutcome {
+    fn finish(&self, result: Result<(), DownloaderError>) {
+        let state = match result {
+            Ok(()) => 1,
+            Err(DownloaderError::Manifest(_)) => 3,
+            Err(DownloaderError::Cancelled) => 4,
+            Err(_) => 2,
+        };
+        self.state.store(state, Ordering::Release);
+        self.notify.notify_one();
+    }
+
+    fn is_done(&self) -> bool {
+        self.state.load(Ordering::Acquire) != 0
+    }
+
+    fn failure(&self) -> Option<InstallFailureKind> {
+        match self.state.load(Ordering::Acquire) {
+            2 => Some(InstallFailureKind::Download),
+            3 => Some(InstallFailureKind::Installer),
+            4 => Some(InstallFailureKind::Cancelled),
+            _ => None,
+        }
+    }
+}
