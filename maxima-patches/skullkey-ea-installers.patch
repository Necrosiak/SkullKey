+//! Account-owned legacy keys. Values never implement Serialize or plaintext Debug.
+use super::{
+    locale::Locale,
+    service_layer::{
+        ServiceLayerClient, SERVICE_REQUEST_GETLEGACYCATALOGDEFS,
+        SERVICE_REQUEST_GETLEGACYENTITLEMENTS,
+    },
+};
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{BTreeSet, HashSet},
+    fmt,
+};
+
+pub struct LegacyCdKey(String);
+impl fmt::Debug for LegacyCdKey {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("LegacyCdKey([REDACTED])")
+    }
+}
+impl LegacyCdKey {
+    #[cfg(test)]
+    pub(crate) fn fixture() -> Self {
+        Self("FIXTURE-KEY".into())
+    }
+
+    // Only the installer integration may consume the value. No public export API.
+    #[allow(dead_code)]
+    pub(crate) fn as_secret_str(&self) -> &str {
+        &self.0
+    }
+}
+
+#[derive(Debug, thiserror::Error, PartialEq)]
+pub enum LegacyKeyError {
+    #[error("legacy key request unavailable")]
+    Unavailable,
+    #[error("legacy key pagination invalid")]
+    Pagination,
+    #[error("multiple distinct legacy keys match this game")]
+    Ambiguous,
+    #[error("legacy key data invalid")]
+    Invalid,
+}
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct CatalogVariables {
+    offer_ids: Vec<String>,
+    locale: Locale,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Catalog {
+    offer_id: String,
+    content_id: String,
+}
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Variables {
+    limit: u32,
+    next: Option<String>,
+    store_fronts: Vec<&'static str>,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Entry {
+    product_id: String,
+    status: String,
+    #[serde(default)]
+    cd_key: Option<String>,
+    #[serde(default)]
+    is_subscription_expired: bool,
+    #[serde(default)]
+    termination_date: Option<String>,
+}
+#[derive(Deserialize)]
+struct Page {
+    next: Option<String>,
+    items: Vec<Entry>,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Me {
+    legacy_entitlements: Page,
+}
+
+fn consider(
+    keys: &mut BTreeSet<String>,
+    entry: Entry,
+    ids: &HashSet<String>,
+    now: DateTime<Utc>,
+) -> Result<(), LegacyKeyError> {
+    if !ids.contains(&entry.product_id) || entry.status != "ACTIVE" || entry.is_subscription_expired
+    {
+        return Ok(());
+    }
+    if let Some(date) = entry.termination_date.filter(|s| !s.is_empty()) {
+        let expiry = DateTime::parse_from_rfc3339(&date).map_err(|_| LegacyKeyError::Invalid)?;
+        if expiry <= now {
+            return Ok(());
+        }
+    }
+    if let Some(key) = entry.cd_key.filter(|s| !s.trim().is_empty()) {
+        // Reject control characters and oversized payloads before installer use.
+        // Preserve original punctuation; each game's installer defines its format.
+        if key.len() > 256
+            || !key
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b' '))
+        {
+            return Err(LegacyKeyError::Invalid);
+        }
+        keys.insert(key);
+    }
+    Ok(())
+}
+fn finish(mut keys: BTreeSet<String>) -> Result<Option<LegacyCdKey>, LegacyKeyError> {
+    if keys.len() > 1 {
+        return Err(LegacyKeyError::Ambiguous);
+    }
+    Ok(keys.pop_first().map(LegacyCdKey))
+}
+
+/// Match only this offer and its catalog content ID. Never pick an arbitrary
+/// key from an edition, DLC, similarly named game, or another account.
+pub async fn resolve_for_offer(
+    client: &ServiceLayerClient,
+    offer: &str,
+) -> Result<Option<LegacyCdKey>, LegacyKeyError> {
+    if offer.trim().is_empty() {
+        return Err(LegacyKeyError::Invalid);
+    }
+    let catalog: Vec<Catalog> = client
+        .request(
+            SERVICE_REQUEST_GETLEGACYCATALOGDEFS,
+            CatalogVariables {
+                offer_ids: vec![offer.to_owned()],
+                locale: Locale::EnUs,
+            },
+        )
+        .await
+        .map_err(|_| LegacyKeyError::Unavailable)?;
+    let mut ids = HashSet::from([offer.to_owned()]);
+    for record in catalog {
+        if record.offer_id == offer && !record.content_id.is_empty() {
+            ids.insert(record.content_id);
+        }
+    }
+    let mut keys = BTreeSet::new();
+    let mut next = None;
+    let mut seen = HashSet::new();
+    let now = Utc::now();
+    for _ in 0..50 {
+        let response: Me = client
+            .request(
+                SERVICE_REQUEST_GETLEGACYENTITLEMENTS,
+                Variables {
+                    limit: 100,
+                    next: next.clone(),
+                    store_fronts: vec!["EA"],
+                },
+            )
+            .await
+            .map_err(|_| LegacyKeyError::Unavailable)?;
+        for entry in response.legacy_entitlements.items {
+            consider(&mut keys, entry, &ids, now)?;
+        }
+        next = response.legacy_entitlements.next.filter(|s| !s.is_empty());
+        match &next {
+            None => return finish(keys),
+            Some(cursor) if !seen.insert(cursor.clone()) => return Err(LegacyKeyError::Pagination),
+            _ => {}
+        }
+    }
+    Err(LegacyKeyError::Pagination)
+}
+
+#[cfg(test)]
+mod legacy_key_regression {
+    use super::*;
+    fn entry(product: &str, key: &str) -> Entry {
+        Entry {
+            product_id: product.into(),
+            status: "ACTIVE".into(),
+            cd_key: Some(key.into()),
+            is_subscription_expired: false,
+            termination_date: None,
+        }
+    }
+    fn ids() -> HashSet<String> {
+        HashSet::from(["owned-offer".into(), "content-id".into()])
+    }
+    #[test]
+    fn exact_mapping_ignores_unrelated_games() {
+        let mut keys = BTreeSet::new();
+        consider(
+            &mut keys,
+            entry("other-game", "TEST-OTHER"),
+            &ids(),
+            Utc::now(),
+        )
+        .unwrap();
+        assert!(finish(keys).unwrap().is_none());
+    }
+    #[test]
+    fn identical_entitlement_keys_are_deduplicated() {
+        let mut keys = BTreeSet::new();
+        for product in ["owned-offer", "content-id"] {
+            consider(&mut keys, entry(product, "TEST-KEY-A"), &ids(), Utc::now()).unwrap();
+        }
+        assert_eq!(finish(keys).unwrap().unwrap().as_secret_str(), "TEST-KEY-A");
+    }
+    #[test]
+    fn distinct_keys_are_not_guessed() {
+        let mut keys = BTreeSet::new();
+        for key in ["TEST-KEY-A", "TEST-KEY-B"] {
+            consider(&mut keys, entry("owned-offer", key), &ids(), Utc::now()).unwrap();
+        }
+        assert_eq!(finish(keys).unwrap_err(), LegacyKeyError::Ambiguous);
+    }
+    #[test]
+    fn revoked_expired_and_subscription_expired_are_ignored() {
+        let mut keys = BTreeSet::new();
+        for kind in 0..3 {
+            let mut e = entry("owned-offer", "TEST-EXPIRED");
+            if kind == 0 {
+                e.status = "DELETED".into();
+            }
+            if kind == 1 {
+                e.termination_date = Some("2000-01-01T00:00:00Z".into());
+            }
+            if kind == 2 {
+                e.is_subscription_expired = true;
+            }
+            consider(&mut keys, e, &ids(), Utc::now()).unwrap();
+        }
+        assert!(finish(keys).unwrap().is_none());
+    }
+    #[test]
+    fn missing_empty_key_is_not_a_failure() {
+        let mut keys = BTreeSet::new();
+        consider(&mut keys, entry("owned-offer", "  "), &ids(), Utc::now()).unwrap();
+        assert!(finish(keys).unwrap().is_none());
+    }
+    #[test]
+    fn malformed_key_and_expiry_are_rejected() {
+        let mut keys = BTreeSet::new();
+        assert_eq!(
+            consider(
+                &mut keys,
+                entry("owned-offer", "TEST\nKEY"),
+                &ids(),
+                Utc::now()
+            ),
+            Err(LegacyKeyError::Invalid)
+        );
+        let mut e = entry("owned-offer", "TEST-KEY-A");
+        e.termination_date = Some("invalid".into());
+        assert_eq!(
+            consider(&mut keys, e, &ids(), Utc::now()),
+            Err(LegacyKeyError::Invalid)
+        );
+    }
+    #[test]
+    fn shell_metacharacters_in_api_keys_are_rejected() {
+        for key in ["TEST&COMMAND", "TEST;COMMAND", "TEST\"KEY", "TEST%PATH%"] {
+            let mut keys = BTreeSet::new();
+            assert_eq!(
+                consider(&mut keys, entry("owned-offer", key), &ids(), Utc::now()),
+                Err(LegacyKeyError::Invalid)
+            );
+        }
+    }
+    #[test]
+    fn debug_never_exposes_value() {
+        let key = LegacyCdKey("TEST-SECRET-VALUE".into());
+        assert_eq!(format!("{:?}", key), "LegacyCdKey([REDACTED])");
+    }
+}
